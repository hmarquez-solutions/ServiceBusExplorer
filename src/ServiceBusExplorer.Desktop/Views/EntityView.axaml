<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ServiceBusExplorer.Desktop.ViewModels"
             xmlns:models="using:ServiceBusExplorer.Desktop.Models"
             x:Class="ServiceBusExplorer.Desktop.Views.EntityView"
             x:DataType="vm:EntityViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.statLabel">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.statValue">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox.messages ListBoxItem">
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="TabControl.inspector TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,4" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Header: what you're looking at, and its counts -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="0,0,0,1" Padding="18,14,18,0">
      <StackPanel Spacing="4">
        <TextBlock Classes="muted" FontSize="12" Text="{Binding Breadcrumb}" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="{Binding Entity.Name}" FontSize="22" FontWeight="SemiBold" />
          <Border CornerRadius="10" Padding="8,2" VerticalAlignment="Center" BorderThickness="1"
                  BorderBrush="{DynamicResource OkBrush}" IsVisible="{Binding IsActiveStatus}">
            <TextBlock FontSize="11" Foreground="{DynamicResource OkBrush}" Text="{Binding Entity.Status}" />
          </Border>
          <Border CornerRadius="10" Padding="8,2" VerticalAlignment="Center" BorderThickness="1"
                  BorderBrush="{DynamicResource WarnBrush}" IsVisible="{Binding !IsActiveStatus}">
            <TextBlock FontSize="11" Foreground="{DynamicResource WarnBrush}" Text="{Binding Entity.Status}" />
          </Border>
          <Border CornerRadius="4" Padding="7,2" VerticalAlignment="Center" Background="{DynamicResource RaisedBrush}">
            <TextBlock FontSize="11" Classes="muted" Text="{Binding KindLabel}" />
          </Border>
          <Border CornerRadius="4" Padding="7,2" VerticalAlignment="Center" Background="{DynamicResource RaisedBrush}"
                  IsVisible="{Binding Entity.RequiresSession}">
            <TextBlock FontSize="11" Classes="muted" Text="Sessions" />
          </Border>
        </StackPanel>

        <WrapPanel Margin="0,10,0,0">
          <StackPanel Margin="0,0,28,0">
            <TextBlock Classes="statLabel" Text="ACTIVE" />
            <TextBlock Classes="statValue" Text="{Binding ActiveText}" />
          </StackPanel>
          <StackPanel Margin="0,0,28,0">
            <TextBlock Classes="statLabel" Text="DEAD-LETTER" />
            <TextBlock Classes="statValue" Foreground="{DynamicResource BadBrush}" Text="{Binding DeadLetterText}" />
          </StackPanel>
          <StackPanel Margin="0,0,28,0">
            <TextBlock Classes="statLabel" Text="SCHEDULED" />
            <TextBlock Classes="statValue" Text="{Binding ScheduledText}" />
          </StackPanel>
          <StackPanel Margin="0,0,28,0">
            <TextBlock Classes="statLabel" Text="TRANSFER DLQ" />
            <TextBlock Classes="statValue" Text="{Binding TransferDeadLetterText}" />
          </StackPanel>
          <StackPanel Margin="0,0,28,0">
            <TextBlock Classes="statLabel" Text="SIZE" />
            <TextBlock Classes="statValue" Text="{Binding SizeText}" />
          </StackPanel>
        </WrapPanel>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" IsVisible="{Binding HasMessages}">
          <Button Classes="tab" Classes.selected="{Binding IsActiveSource}" Content="Messages"
                  Command="{Binding ShowSourceCommand}" CommandParameter="{x:Static models:MessageSource.Active}" />
          <Button Classes="tab" Classes.selected="{Binding IsDeadLetterSource}" Content="Dead-letter"
                  Command="{Binding ShowSourceCommand}" CommandParameter="{x:Static models:MessageSource.DeadLetter}" />
          <Button Classes="tab" Classes.selected="{Binding IsScheduledSource}" Content="Scheduled"
                  Command="{Binding ShowSourceCommand}" CommandParameter="{x:Static models:MessageSource.Scheduled}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Messages and inspector -->
    <Grid ColumnDefinitions="*,4,400">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="12,8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Peek top" VerticalAlignment="Center" Classes="muted" />
            <TextBox Classes="mono" Width="70" Text="{Binding PeekCount}" IsEnabled="{Binding CanBrowse}" />
            <Button Content="Peek" Classes="accent" Command="{Binding PeekCommand}" IsEnabled="{Binding CanBrowse}"
                    ToolTip.Tip="Reads messages without locking or removing them" />
            <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsLoading}" VerticalAlignment="Center" />
            <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" Text="{Binding Notice}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Margin="12,8" Foreground="{DynamicResource BadBrush}" TextWrapping="Wrap"
                   Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Column headers; widths match the row template below. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="12,6">
          <Grid ColumnDefinitions="80,1.4*,*,140,64,64,1.2*">
            <TextBlock Grid.Column="0" Classes="columnHeader" Text="SEQ #" />
            <TextBlock Grid.Column="1" Classes="columnHeader" Text="MESSAGE ID" />
            <TextBlock Grid.Column="2" Classes="columnHeader" Text="SUBJECT" />
            <TextBlock Grid.Column="3" Classes="columnHeader" Text="{Binding TimeColumnHeader}" />
            <TextBlock Grid.Column="4" Classes="columnHeader" Text="DELIVERIES" />
            <TextBlock Grid.Column="5" Classes="columnHeader" Text="SIZE" />
            <TextBlock Grid.Column="6" Classes="columnHeader" Text="DEAD-LETTER REASON" IsVisible="{Binding IsDeadLetterSource}" />
          </Grid>
        </Border>

        <ListBox Classes="messages" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:MessageViewModel">
              <Grid ColumnDefinitions="80,1.4*,*,140,64,64,1.2*">
                <TextBlock Grid.Column="0" Classes="mono" Text="{Binding SequenceNumber}" />
                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding MessageId}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                <TextBlock Grid.Column="2" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                <TextBlock Grid.Column="3" Text="{Binding EnqueuedText}"
                           IsVisible="{Binding !$parent[ListBox].((vm:EntityViewModel)DataContext).IsScheduledSource}" />
                <TextBlock Grid.Column="3" Text="{Binding ScheduledText}"
                           IsVisible="{Binding $parent[ListBox].((vm:EntityViewModel)DataContext).IsScheduledSource}" />
                <TextBlock Grid.Column="4" Text="{Binding DeliveryCount}" />
                <TextBlock Grid.Column="5" Text="{Binding SizeText}" />
                <TextBlock Grid.Column="6" Text="{Binding DeadLetterReason}" Foreground="{DynamicResource BadBrush}"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding $parent[ListBox].((vm:EntityViewModel)DataContext).IsDeadLetterSource}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="1" Background="{DynamicResource LineBrush}" ResizeDirection="Columns" />

      <!-- Inspector -->
      <Border Grid.Column="2" Background="{DynamicResource PanelBrush}">
        <Panel>
          <TextBlock Classes="muted" Text="Select a message to inspect it." HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding SelectedMessage, Converter={x:Static ObjectConverters.IsNull}}" />
          <DockPanel DataContext="{Binding SelectedMessage}" x:DataType="vm:MessageViewModel"
                     IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel DockPanel.Dock="Top" Margin="14,12,14,8" Spacing="4">
              <TextBlock FontWeight="SemiBold" Text="{Binding SequenceNumber, StringFormat='Seq #{0}'}" />
              <SelectableTextBlock Classes="mono muted" Text="{Binding MessageId}" />
              <Border Margin="0,6,0,0" Padding="10,8" Background="{DynamicResource BadSoftBrush}"
                      BorderBrush="{DynamicResource BadBrush}" BorderThickness="3,0,0,0" IsVisible="{Binding HasDeadLetterReason}">
                <StackPanel Spacing="2">
                  <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource BadBrush}" Text="{Binding DeadLetterReason}" />
                  <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding DeadLetterDescription}" />
                </StackPanel>
              </Border>
            </StackPanel>

            <TabControl Classes="inspector" Margin="6,0,6,6">
              <TabItem Header="Body">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Classes="muted" FontSize="12" Margin="4,4,4,6" Text="{Binding BodySummary}" />
                  <TextBox Classes="mono" Text="{Binding BodyText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                           TextWrapping="NoWrap" VerticalAlignment="Stretch" />
                </DockPanel>
              </TabItem>
              <TabItem Header="Properties">
                <ScrollViewer>
                  <StackPanel>
                    <TextBlock Classes="muted" Margin="4" Text="No application properties."
                               IsVisible="{Binding !ApplicationProperties.Count}" />
                    <ItemsControl ItemsSource="{Binding ApplicationProperties}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:PropertyRow">
                          <Grid ColumnDefinitions="170,*" Margin="4,3">
                            <TextBlock Classes="muted" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <SelectableTextBlock Grid.Column="1" Classes="mono" Text="{Binding Value}" TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="System">
                <ScrollViewer>
                  <ItemsControl ItemsSource="{Binding SystemProperties}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:PropertyRow">
                        <Grid ColumnDefinitions="170,*" Margin="4,3">
                          <TextBlock Classes="muted" Text="{Binding Name}" />
                          <SelectableTextBlock Grid.Column="1" Classes="mono" Text="{Binding Value}" TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </TabItem>
            </TabControl>
          </DockPanel>
        </Panel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
